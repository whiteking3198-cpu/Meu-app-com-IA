import { useMemo, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { CircularProgress } from "@/components/CircularProgress";
import { Target, TrendingUp, Wallet, Calendar, Sparkles } from "lucide-react";
import { toast } from "@/hooks/use-toast";

const formatBRL = (n: number) =>
  n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

// Formata YYYY-MM-DD a partir de um Date local (sem timezone shift)
const toISODate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};

// Dias restantes entre hoje (00:00) e a data final (00:00)
const daysUntil = (isoDate: string): number => {
  if (!isoDate) return 0;
  const [y, m, d] = isoDate.split("-").map(Number);
  if (!y || !m || !d) return 0;
  const end = new Date(y, m - 1, d);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  end.setHours(0, 0, 0, 0);
  const diffMs = end.getTime() - today.getTime();
  return Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
};

// Calcula quanto poupar por dia para bater a meta no prazo
const calcDailyTarget = (total: number, saved: number, daysLeft: number): number => {
  const remaining = Math.max(0, total - saved);
  if (remaining === 0) return 0;
  if (daysLeft <= 0) return remaining; // prazo vencido: precisa do total restante
  return remaining / daysLeft;
};

// Data padrão = hoje + 90 dias
const defaultDeadline = () => {
  const d = new Date();
  d.setDate(d.getDate() + 90);
  return toISODate(d);
};

const Index = () => {
  const [item, setItem] = useState("iPhone 15 Pro");
  const [total, setTotal] = useState<string>("8500");
  const [deadline, setDeadline] = useState<string>(defaultDeadline());
  const [saved, setSaved] = useState<number>(2380);
  const [depositInput, setDepositInput] = useState<string>("");

  const totalNum = parseFloat(total) || 0;
  const daysLeft = useMemo(() => daysUntil(deadline), [deadline]);

  const remaining = Math.max(0, totalNum - saved);
  const perDay = useMemo(
    () => calcDailyTarget(totalNum, saved, daysLeft),
    [totalNum, saved, daysLeft]
  );
  const progress = totalNum > 0 ? Math.min(100, (saved / totalNum) * 100) : 0;

  const registerDeposit = (amount: number) => {
    if (!amount || amount <= 0) {
      toast({ title: "Informe um valor válido para o depósito." });
      return;
    }
    setSaved((s) => Math.min(totalNum, s + amount));
    setDepositInput("");
    toast({
      title: "Depósito registrado!",
      description: `+${formatBRL(amount)} adicionados à sua meta.`,
    });
  };

  return (
    <div className="min-h-screen px-4 py-8 md:px-8 md:py-12">
      <div className="mx-auto max-w-6xl">
        {/* Header */}
        <header className="mb-10 flex items-center justify-between animate-fade-in">
          <div className="flex items-center gap-3">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-primary shadow-emerald">
              <Target className="h-5 w-5 text-primary-foreground" strokeWidth={2.5} />
            </div>
            <div>
              <h1 className="text-xl font-bold tracking-tight">Gerenciador de Metas</h1>
              <p className="text-xs text-muted-foreground">Realize seus sonhos, um dia de cada vez</p>
            </div>
          </div>
          <Button variant="outline" className="hidden md:inline-flex rounded-full border-border/60 bg-secondary/50">
            <Sparkles className="mr-2 h-4 w-4 text-primary" />
            Premium
          </Button>
        </header>

        {/* Active Goal Card */}
        <Card className="mb-8 overflow-hidden border-border/40 bg-gradient-card shadow-card animate-scale-in">
          <div className="relative grid gap-8 p-6 md:p-10 md:grid-cols-[auto,1fr] md:items-center">
            <div className="flex justify-center md:justify-start">
              <CircularProgress
                value={progress}
                size={220}
                label="da meta"
                sublabel="conquistada"
              />
            </div>
            <div className="space-y-6">
              <div>
                <span className="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                  <span className="h-1.5 w-1.5 rounded-full bg-primary animate-pulse" />
                  META ATIVA
                </span>
                <h2 className="mt-3 text-3xl md:text-4xl font-bold tracking-tight">
                  {item || "Sua próxima conquista"}
                </h2>
              </div>

              <div className="grid grid-cols-3 gap-4">
                <div className="rounded-2xl bg-secondary/50 p-4">
                  <p className="text-xs text-muted-foreground">Poupado</p>
                  <p className="mt-1 text-lg font-bold text-gradient-emerald">
                    {formatBRL(saved)}
                  </p>
                </div>
                <div className="rounded-2xl bg-secondary/50 p-4">
                  <p className="text-xs text-muted-foreground">Faltam</p>
                  <p className="mt-1 text-lg font-bold">{formatBRL(remaining)}</p>
                </div>
                <div className="rounded-2xl bg-secondary/50 p-4">
                  <p className="text-xs text-muted-foreground">Dias restantes</p>
                  <p className="mt-1 text-lg font-bold">{daysLeft}</p>
                </div>
              </div>

              <div className="flex flex-col sm:flex-row gap-3">
                <Input
                  type="number"
                  inputMode="decimal"
                  placeholder={`Ex: ${perDay > 0 ? perDay.toFixed(2) : "100.00"}`}
                  value={depositInput}
                  onChange={(e) => setDepositInput(e.target.value)}
                  className="h-12 rounded-full bg-secondary/50 border-border/40 focus-visible:ring-primary sm:max-w-[200px]"
                />
                <Button
                  onClick={() => registerDeposit(parseFloat(depositInput))}
                  className="rounded-full bg-gradient-primary text-primary-foreground hover:opacity-90 shadow-emerald font-semibold"
                  size="lg"
                >
                  <Wallet className="mr-2 h-4 w-4" />
                  Registrar depósito
                </Button>
                <Button
                  variant="outline"
                  size="lg"
                  className="rounded-full border-border/60 bg-secondary/50"
                  onClick={() => registerDeposit(perDay)}
                >
                  Depositar meta diária
                </Button>
              </div>
            </div>
          </div>
        </Card>

        {/* Form + Result */}
        <div className="grid gap-6 lg:grid-cols-5">
          <Card className="lg:col-span-3 border-border/40 bg-gradient-card shadow-card animate-fade-in">
            <CardHeader>
              <CardTitle className="flex items-center gap-2 text-lg">
                <Target className="h-5 w-5 text-primary" />
                Criar nova meta
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-5">
              <div className="space-y-2">
                <Label htmlFor="item" className="text-sm text-muted-foreground">
                  O que você quer comprar?
                </Label>
                <Input
                  id="item"
                  value={item}
                  onChange={(e) => setItem(e.target.value)}
                  placeholder="Ex: Notebook novo, viagem para Portugal..."
                  className="h-12 rounded-xl bg-secondary/50 border-border/40 focus-visible:ring-primary"
                />
              </div>
              <div className="grid gap-5 sm:grid-cols-2">
                <div className="space-y-2">
                  <Label htmlFor="total" className="text-sm text-muted-foreground">
                    Valor total (R$)
                  </Label>
                  <Input
                    id="total"
                    type="number"
                    value={total}
                    onChange={(e) => setTotal(e.target.value)}
                    placeholder="0,00"
                    className="h-12 rounded-xl bg-secondary/50 border-border/40 focus-visible:ring-primary"
                  />
                </div>
                <div className="space-y-2">
                  <Label htmlFor="deadline" className="text-sm text-muted-foreground">
                    Data final
                  </Label>
                  <Input
                    id="deadline"
                    type="date"
                    value={deadline}
                    min={toISODate(new Date())}
                    onChange={(e) => setDeadline(e.target.value)}
                    className="h-12 rounded-xl bg-secondary/50 border-border/40 focus-visible:ring-primary"
                  />
                </div>
              </div>
              <Button
                className="w-full h-12 rounded-xl bg-gradient-primary text-primary-foreground hover:opacity-90 shadow-emerald font-semibold"
                onClick={() => {
                  setSaved(0);
                  toast({ title: "Meta reiniciada", description: "Bons depósitos!" });
                }}
              >
                Definir como meta ativa
              </Button>
            </CardContent>
          </Card>

          {/* Highlight result */}
          <Card className="lg:col-span-2 relative overflow-hidden border-primary/30 bg-gradient-card shadow-emerald animate-fade-in">
            <div className="absolute inset-0 bg-gradient-primary opacity-10" />
            <div className="relative p-6 flex flex-col h-full justify-between">
              <div className="flex items-center gap-2 text-primary">
                <TrendingUp className="h-5 w-5" />
                <span className="text-xs font-semibold uppercase tracking-wider">
                  Plano diário
                </span>
              </div>
              <div className="py-6">
                <p className="text-sm text-muted-foreground">
                  {remaining === 0 ? "Meta concluída! 🎉" : "Você precisa poupar"}
                </p>
                <p className="my-2 text-5xl md:text-6xl font-extrabold text-gradient-emerald leading-none">
                  {formatBRL(perDay)}
                </p>
                <p className="text-sm text-muted-foreground">
                  {daysLeft > 0
                    ? `por dia, durante ${daysLeft} dia${daysLeft > 1 ? "s" : ""}`
                    : "prazo encerrado"}
                </p>
              </div>
              <div className="flex items-center gap-2 rounded-xl bg-background/40 p-3 text-xs text-muted-foreground">
                <Calendar className="h-4 w-4 text-primary shrink-0" />
                <span>
                  Mantendo o ritmo, você conquista{" "}
                  <strong className="text-foreground">{item || "sua meta"}</strong> até{" "}
                  <strong className="text-foreground">
                    {deadline
                      ? new Date(deadline + "T00:00:00").toLocaleDateString("pt-BR")
                      : "—"}
                  </strong>
                  .
                </span>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  );
};

export default Index;

